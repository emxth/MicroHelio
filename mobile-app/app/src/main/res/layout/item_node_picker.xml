<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNodePicker"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/pure_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPickerNodeCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ST-001 - Central Microgrid"
                android:textColor="@color/dark_pine"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPickerNodeAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location address"
                android:textColor="@color/moss_gray"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPickerNodeSlots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery Slots: 8 / 10 available"
                android:textColor="@color/deep_canopy_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPickerNodeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Active"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_status_badge_active"
            android:textColor="#2D6A4F" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
