<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_off_white">

    <!-- Top Header Bar with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_canopy_green"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Go Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Microgrid Node Details"
                android:textColor="@color/pure_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Station specifications &amp; slot status"
                android:textColor="@color/soft_sunlight"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Node Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/pure_white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Title & Status Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailNodeCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Node Code"
                                android:textColor="@color/dark_pine"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Node Name"
                                android:textColor="@color/moss_gray"
                                android:textSize="15sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Active"
                            android:textColor="#2D6A4F"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/bg_status_badge_active" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E8ECE9"
                        android:layout_marginBottom="16dp" />

                    <!-- 2x2 Metric Cards Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="10dp">

                        <!-- Capacity Stat Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/bg_metric_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Capacity"
                                android:textColor="@color/moss_gray"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetailCapacity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50 kWh"
                                android:textColor="@color/deep_canopy_green"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Battery Slots Stat Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/bg_metric_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery Slots"
                                android:textColor="@color/moss_gray"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetailBatterySlots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6 / 10 available"
                                android:textColor="@color/dark_pine"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Operating Hours & Schedule Stat Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_metric_card"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Operating Hours &amp; Days"
                            android:textColor="@color/moss_gray"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvDetailSchedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00 - 18:00 (Mon, Tue, Wed, Thu, Fri, Sat, Sun)"
                            android:textColor="@color/dark_pine"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Location & GPS Details -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Station Location Address"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address details"
                        android:textColor="@color/dark_pine"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS Coordinates"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDetailCoordinates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lat: 6.9271, Long: 79.8612"
                        android:textColor="@color/dark_pine"
                        android:textSize="14sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <!-- Primary Action Button -->
            <Button
                android:id="@+id/btnBookSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Book Energy Slot at this Node"
                android:textColor="@color/pure_white"
                android:backgroundTint="@color/deep_canopy_green"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:paddingVertical="14dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Shared Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>
