<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAF7"
    tools:context=".ProsumerProfileActivity">

    <!-- Header Bar with Back Arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2D6A4F"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Back Arrow Button -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:contentDescription="Back"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile Avatar Circle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_profile_circle"
                    android:contentDescription="Profile" />
            </LinearLayout>

            <!-- Profile Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section: Personal Info -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL INFORMATION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#52B788"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Name: Loading..."
                        android:textSize="15sp"
                        android:textColor="#1B2621"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvNic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NIC: Loading..."
                        android:textSize="15sp"
                        android:textColor="#1B2621"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email: Loading..."
                        android:textSize="15sp"
                        android:textColor="#1B2621"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone: Loading..."
                        android:textSize="15sp"
                        android:textColor="#1B2621"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address: Loading..."
                        android:textSize="15sp"
                        android:textColor="#1B2621"
                        android:layout_marginBottom="4dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E9F5EE"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Section: Account Status -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCOUNT STATUS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#52B788"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvActivationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Activation: Loading..."
                        android:textSize="15sp"
                        android:textColor="#1B2621"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: Loading..."
                        android:textSize="15sp"
                        android:textColor="#1B2621"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvCreatedDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Created: Loading..."
                        android:textSize="13sp"
                        android:textColor="#748C7E" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Edit Profile Button -->
            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Edit Profile"
                android:backgroundTint="#2D6A4F"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Logout Button -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Logout"
                android:backgroundTint="#FFFFFF"
                android:textColor="#E53935"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E53935"
                app:strokeWidth="1.5dp"
                android:layout_marginBottom="12dp" />

            <!-- Deactivate Button -->
            <Button
                android:id="@+id/btnDeactivate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Deactivate Account"
                android:backgroundTint="#E53935"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
