<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_off_white"
    tools:context=".ProsumerProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_canopy_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:contentDescription="Back"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_my_profile"
                android:textColor="@color/pure_white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_profile_circle"
                    android:contentDescription="Profile" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_personal_information"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/vibrant_leaf_green"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_name_loading"
                        android:textSize="15sp"
                        android:textColor="@color/dark_pine"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvNic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_nic_loading"
                        android:textSize="15sp"
                        android:textColor="@color/dark_pine"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_email_loading"
                        android:textSize="15sp"
                        android:textColor="@color/dark_pine"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_phone_loading"
                        android:textSize="15sp"
                        android:textColor="@color/dark_pine"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_address_loading"
                        android:textSize="15sp"
                        android:textColor="@color/dark_pine"
                        android:layout_marginBottom="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_E9F5EE"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_account_status"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/vibrant_leaf_green"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvActivationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_activation_loading"
                        android:textSize="15sp"
                        android:textColor="@color/dark_pine"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_status_loading"
                        android:textSize="15sp"
                        android:textColor="@color/dark_pine"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvCreatedDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_created_loading"
                        android:textSize="13sp"
                        android:textColor="@color/moss_gray" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/str_edit_profile"
                android:backgroundTint="@color/deep_canopy_green"
                android:textColor="@color/pure_white"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/str_logout"
                android:backgroundTint="@color/pure_white"
                android:textColor="@color/color_E53935"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E53935"
                app:strokeWidth="1.5dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDeactivate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/str_deactivate_account"
                android:backgroundTint="@color/color_E53935"
                android:textColor="@color/pure_white"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
