<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/pure_white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvItemTrxCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tvTrxCode"
                android:textColor="@color/dark_pine"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemTrxStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/vibrant_leaf_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/tvItemTrxStatus"
                android:textColor="@color/pure_white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemProsumerNic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tvProsumerNic"
            android:textColor="@color/dark_pine"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvItemKWh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tvItemKWh"
            android:textColor="@color/moss_gray"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
