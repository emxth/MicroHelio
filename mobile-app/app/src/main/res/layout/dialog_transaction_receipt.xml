<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Receipt Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rcpHeader"
                android:textColor="@color/deep_canopy_green"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rcpSubHeader"
                android:textColor="@color/moss_gray"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReceiptStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tvReceiptStatusBadge"
            android:textColor="@color/pure_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#2D6A4F"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <!-- Receipt Details Table -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F7FAF7"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/rcpTrxCode"
                android:textColor="@color/moss_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptTrxCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tvTrxCode"
                android:textColor="@color/dark_pine"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/listNic"
                android:textColor="@color/moss_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptProsumerNic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tvProsumerNicDetail"
                android:textColor="@color/dark_pine"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/rcpStationId"
                android:textColor="@color/moss_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptNodeId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tvNodeDetail"
                android:textColor="@color/dark_pine"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/rcpResFef"
                android:textColor="@color/moss_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptReservationId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rcpResId"
                android:textColor="@color/dark_pine"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/rcpEnrTran"
                android:textColor="@color/moss_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptEnergyKWh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tvCapacityDetail"
                android:textColor="@color/deep_canopy_green"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/rcpDateTime"
                android:textColor="@color/moss_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rcpDateTimeVal"
                android:textColor="@color/dark_pine"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvReceiptSecurityFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tvReceiptSecurityFooter"
        android:textColor="@color/moss_gray"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCloseReceipt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btnCloseReceipt"
        android:backgroundTint="@color/deep_canopy_green"
        android:textColor="@color/pure_white"
        app:cornerRadius="8dp" />

</LinearLayout>
