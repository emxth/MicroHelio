<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_off_white">

    <!-- Top Header Bar with Professional Back Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_canopy_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_go_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_new_reservation_title"
                android:textColor="@color/pure_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_new_reservation_sub"
                android:textColor="@color/soft_sunlight"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Form Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/pure_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Prosumer NIC (Read-Only Field) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_prosumer_nic"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etProsumerNic"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="981234567V"
                        android:enabled="false"
                        android:textColor="@color/dark_pine"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_search_input"
                        android:layout_marginBottom="16dp"/>

                    <!-- Select Microgrid Station Card Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_select_station"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/cardSelectNode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="54dp"
                        android:background="@drawable/bg_card_selector"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSelectedNodeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_tap_select_station"
                                android:textColor="@color/dark_pine"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSelectedNodeSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_choose_station_location"
                                android:textColor="@color/moss_gray"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textColor="@color/deep_canopy_green"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Hidden legacy spinner for compatibility -->
                    <Spinner
                        android:id="@+id/spinnerNodes"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Select Time Slot Card Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_select_slot"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/cardSelectSlot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="54dp"
                        android:background="@drawable/bg_card_selector"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSelectedSlotTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_tap_choose_slot"
                                android:textColor="@color/dark_pine"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSelectedSlotSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_view_available_reserved_slots"
                                android:textColor="@color/moss_gray"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textColor="@color/deep_canopy_green"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Hidden legacy spinner for compatibility -->
                    <Spinner
                        android:id="@+id/spinnerSlots"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Reservation Type Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_reservation_type"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:background="@color/eco_off_white"
                        android:padding="4dp"
                        android:layout_marginBottom="16dp">

                        <Button
                            android:id="@+id/btnTypeDropOff"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/type_dropoff"
                            android:textColor="@color/pure_white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/deep_canopy_green"
                            app:cornerRadius="8dp" />

                        <Button
                            android:id="@+id/btnTypeCharging"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/type_charging"
                            android:textColor="@color/dark_pine"
                            android:textSize="13sp"
                            android:backgroundTint="@color/eco_off_white"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <!-- Hidden legacy spinner for compatibility -->
                    <Spinner
                        android:id="@+id/spinnerReservationType"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Selected Slot Summary Container -->
                    <LinearLayout
                        android:id="@+id/layoutSlotSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F0F7F4"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_selected_slot"
                            android:textColor="@color/deep_canopy_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSelectedSlotDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_no_slot_selected"
                            android:textColor="@color/dark_pine"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Requested Capacity -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_requested_capacity"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/hint_enter_capacity"
                        android:inputType="numberDecimal"
                        android:textColor="@color/dark_pine"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_search_input"
                        android:layout_marginBottom="24dp"/>

                    <!-- Confirm Reservation Action Button -->
                    <Button
                        android:id="@+id/btnSubmitReservation"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/btn_confirm_reservation"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/deep_canopy_green"
                        android:textColor="@color/pure_white"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Shared Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>