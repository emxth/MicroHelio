<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_canopy_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Go Back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_new_energy_reservation"
                android:textColor="@color/pure_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_select_microgrid_node_slot_typ"
                android:textColor="@color/soft_sunlight"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/pure_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_prosumer_nic"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etProsumerNic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/str_981234567v"
                    android:enabled="false"
                    android:textColor="@color/dark_pine"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_select_microgrid_node"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerNodes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_select_available_time_slot"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerSlots"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_reservation_type"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerReservationType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="14dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/eco_off_white"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvSelectedSlotDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_selected_slot_none"
                        android:textColor="@color/dark_pine"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_requested_capacity_kwh"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/str_e_g_5_0"
                    android:inputType="numberDecimal"
                    android:textColor="@color/dark_pine"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btnSubmitReservation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/str_confirm_reservation"
                    android:backgroundTint="@color/deep_canopy_green"
                    android:textColor="@color/pure_white"
                    app:cornerRadius="8dp"
                    android:padding="12dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>