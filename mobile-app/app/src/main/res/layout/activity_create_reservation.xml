<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_canopy_green"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Energy Reservation"
            android:textColor="@color/pure_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select microgrid node, slot, type and input capacity"
            android:textColor="@color/soft_sunlight"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/pure_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Prosumer NIC -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prosumer NIC"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etProsumerNic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="981234567V"
                    android:enabled="false"
                    android:textColor="@color/dark_pine"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <!-- Microgrid Node Dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Microgrid Node"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerNodes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="14dp"/>

                <!-- Energy Booking Slot Dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Available Time Slot"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerSlots"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="14dp"/>

                <!-- Reservation Type Dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservation Type"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerReservationType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="14dp"/>

                <!-- Auto-populated Date & Time Info Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/eco_off_white"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvSelectedSlotDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selected Slot: None"
                        android:textColor="@color/dark_pine"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Requested Capacity with Validation -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requested Capacity (KWh)"
                    android:textColor="@color/moss_gray"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 5.0"
                    android:inputType="numberDecimal"
                    android:textColor="@color/dark_pine"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp"/>

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnSubmitReservation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirm Reservation"
                    android:backgroundTint="@color/deep_canopy_green"
                    android:textColor="@color/pure_white"
                    app:cornerRadius="8dp"
                    android:padding="12dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</LinearLayout>