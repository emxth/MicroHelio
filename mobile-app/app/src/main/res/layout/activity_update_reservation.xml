<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_canopy_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_go_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_manage_reservation"
                android:textColor="@color/pure_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_update_slot_details_or_cancel_"
                android:textColor="@color/soft_sunlight"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFF3CD">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/str_notice_updates_and_cancellatio"
                    android:textColor="@color/color_856404"
                    android:textSize="13sp"
                    android:padding="14dp"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/pure_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_select_microgrid_node"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etProsumerNic"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="981234567V"
                        android:enabled="false"
                        android:textColor="@color/dark_pine"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_search_input"
                        android:layout_marginBottom="16dp"/>

                    <!-- Select Microgrid Station Card Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_select_station"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/cardSelectNode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="54dp"
                        android:background="@drawable/bg_card_selector"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSelectedNodeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_loading_station"
                                android:textColor="@color/dark_pine"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSelectedNodeSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_tap_change_station"
                                android:textColor="@color/moss_gray"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textColor="@color/deep_canopy_green"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Hidden legacy spinner for backward compatibility -->
                    <Spinner
                        android:id="@+id/spinnerNodes"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_select_new_available_time_slot"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:id="@+id/cardSelectSlot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="54dp"
                        android:background="@drawable/bg_card_selector"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSelectedSlotTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_loading_slot"
                                android:textColor="@color/dark_pine"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSelectedSlotSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_tap_pick_new_slot"
                                android:textColor="@color/moss_gray"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textColor="@color/deep_canopy_green"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Hidden legacy spinner for backward compatibility -->
                    <Spinner
                        android:id="@+id/spinnerSlots"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutSlotSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F0F7F4"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_current_booking_details"
                            android:textColor="@color/deep_canopy_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSelectedSlotDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/str_current_slot_loading"
                            android:textColor="@color/dark_pine"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnUpdateReservation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_save_changes"
                        android:backgroundTint="@color/deep_canopy_green"
                        android:textColor="@color/pure_white"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="20dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_E0E0E0"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_cancellation_reason_required_t"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etCancelReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/str_e_g_schedule_changed"
                        android:textColor="@color/dark_pine"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_search_input"
                        android:layout_marginBottom="20dp"/>

                    <Button
                        android:id="@+id/btnCancelReservation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_cancel_booking"
                        android:backgroundTint="@color/color_C92A2A"
                        android:textColor="@color/pure_white"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>