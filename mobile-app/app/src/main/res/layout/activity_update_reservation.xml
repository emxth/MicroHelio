<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eco_off_white">

    <!-- Top Header Bar with Back Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_canopy_green"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Go Back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage Reservation"
                android:textColor="@color/pure_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update slot details or cancel booking"
                android:textColor="@color/soft_sunlight"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Policy Warning Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFF3CD">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notice: Updates and cancellations require at least 12 hours' notice prior to the scheduled start time."
                    android:textColor="#856404"
                    android:textSize="13sp"
                    android:padding="14dp"/>
            </androidx.cardview.widget.CardView>

            <!-- Main Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/pure_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Microgrid Node Dropdown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Microgrid Node"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinnerNodes"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:layout_marginBottom="14dp"/>

                    <!-- Energy Booking Slot Dropdown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select New Available Time Slot"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinnerSlots"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:layout_marginBottom="14dp"/>

                    <!-- Auto-populated Date & Time Info Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/eco_off_white"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvSelectedSlotDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Current Slot: Loading..."
                            android:textColor="@color/dark_pine"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Update Action Button -->
                    <Button
                        android:id="@+id/btnUpdateReservation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Changes"
                        android:backgroundTint="@color/deep_canopy_green"
                        android:textColor="@color/pure_white"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="16dp"
                        android:padding="12dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="16dp"/>

                    <!-- Cancellation Reason -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancellation Reason (Required to Cancel)"
                        android:textColor="@color/moss_gray"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etCancelReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Schedule changed"
                        android:textColor="@color/dark_pine"
                        android:textSize="14sp"
                        android:layout_marginBottom="14dp"/>

                    <!-- Cancel Action Button -->
                    <Button
                        android:id="@+id/btnCancelReservation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cancel Booking"
                        android:backgroundTint="#C92A2A"
                        android:textColor="@color/pure_white"
                        app:cornerRadius="8dp"
                        android:padding="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Shared Bottom Navigation Bar -->
    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>