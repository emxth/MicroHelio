<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/pure_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvReservationCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tvResCode"
                android:textColor="@color/dark_pine"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvStatusBadge"
                android:textColor="@color/pure_white"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@color/soft_sunlight" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvProsumerNic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tvProsumerNic"
            android:textColor="@color/dark_pine"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
            
        <TextView
            android:id="@+id/tvNodeAndType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tvNodeAndType"
            android:textColor="@color/moss_gray"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tvDateTime"
            android:textColor="@color/dark_pine"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tvCapacity"
            android:textColor="@color/deep_canopy_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnViewQrCode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="@color/deep_canopy_green"
            android:text="@string/btnViewQrCode"
            android:textAllCaps="false"
            android:textColor="@color/pure_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>